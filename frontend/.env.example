# Public browser configuration. Never put server or Supabase secret keys here.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Optional: privacy-safe client failure events endpoint. It receives only
# event type, error name, route, and timestamp; no transcript or user data.
# NEXT_PUBLIC_FRONTEND_OBSERVABILITY_ENDPOINT=https://telemetry.example.com/client-events
