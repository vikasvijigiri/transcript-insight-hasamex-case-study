POSTGRES_DB=hasamex
POSTGRES_USER=hasamex
POSTGRES_PASSWORD=replace-with-a-long-random-secret
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-secret

# Use your HTTPS public origins in deployed environments; never use * for this app.
CORS_ORIGINS=https://app.example.com
NEXT_PUBLIC_API_BASE=https://api.example.com

LLM_PROVIDER=gemini
GEMINI_API_KEY=replace-with-a-secret-managed-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OTEL_SERVICE_NAME=hasamex-api
OTEL_EXPORTER_OTLP_ENDPOINT=
SEED_DEMO_CORPUS=false
AUTO_CREATE_SCHEMA=false

# Supabase Auth is the identity broker. Use asymmetric ES256/RS256 signing keys
# in Supabase so this API can verify JWTs with the public JWKS endpoint.
AUTH_REQUIRED=true
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
METRICS_TOKEN=replace-with-a-long-random-secret
LLM_MAX_CONCURRENT_REQUESTS=4
MAX_REQUEST_BYTES=2000000
