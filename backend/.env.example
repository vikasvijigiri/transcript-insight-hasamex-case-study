# Copy this file to .env and fill in the key(s) for whichever provider you use.

# Which provider answers questions: gemini | groq | huggingface — all OpenAI-compatible
# endpoints. Grounding is enforced by us (verbatim-quote substring verification), not
# by the provider. gemini is the default: its free tier (250K TPM) comfortably covers
# this app's multi-call /qa and /themes endpoints, where Groq's free tier (8K TPM)
# gets rate-limited. Groq/HF remain available as manual fallbacks.
LLM_PROVIDER=gemini

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Hugging Face Inference Providers (https://huggingface.co/settings/tokens) ---
HF_API_KEY=hf_...
HF_MODEL=openai/gpt-oss-120b
HF_BASE_URL=https://router.huggingface.co/v1

# --- Misc ---
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
LLM_MAX_RETRIES=3
