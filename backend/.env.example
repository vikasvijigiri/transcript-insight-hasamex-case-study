# Copy this file to .env and fill in the key(s) for whichever provider you use.

# Which provider answers questions: gemini | groq | huggingface — all OpenAI-compatible
# endpoints. Grounding is enforced by us (verbatim-quote substring verification), not
# by the provider. gemini is the default: its free tier (250K TPM) comfortably covers
# this app's multi-call /qa and /themes endpoints, where Groq's free tier (8K TPM)
# gets rate-limited. Groq/HF remain available as manual fallbacks.
LLM_PROVIDER=gemini

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Hugging Face Inference Providers (https://huggingface.co/settings/tokens) ---
HF_API_KEY=hf_...
HF_MODEL=openai/gpt-oss-120b
HF_BASE_URL=https://router.huggingface.co/v1

# --- Misc ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
LLM_MAX_RETRIES=3
LLM_MAX_CONCURRENT_REQUESTS=4
MAX_REQUEST_BYTES=2000000

# --- Production RAG persistence ---
# Local development default: sqlite:///./data/hasamex.db
# Production example: postgresql+psycopg://user:password@host:5432/hasamex
DATABASE_URL=sqlite:///./data/hasamex.db
INGESTION_PASSAGE_MAX_TOKENS=420
INGESTION_PARENT_MAX_TOKENS=1800

# OpenTelemetry is opt-in. Leave blank locally; point at an OTLP/HTTP collector in deployment.
OTEL_SERVICE_NAME=hasamex-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# Keep true only for local development. Containers run Alembic migrations first.
AUTO_CREATE_SCHEMA=true
SEED_DEMO_CORPUS=true
# Complete ACL-filtered source records are permitted only below this size; set 0 to disable.
RAG_FULL_CORPUS_MAX_CHARACTERS=20000

# --- Authentication (Supabase Auth + Google OAuth) ---
# Keep false for local demo mode. Set true on Render after configuring Supabase.
AUTH_REQUIRED=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Set in production and configure the private Prometheus scraper to send it.
METRICS_TOKEN=
