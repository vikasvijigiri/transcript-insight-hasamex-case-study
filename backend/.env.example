# Copy this file to .env and fill in the key(s) for whichever provider you use.

# Which provider answers questions: anthropic | groq | huggingface
# - anthropic: production default. Native Citations API = exact offset-grounded quotes.
# - groq / huggingface: OpenAI-compatible endpoints serving open-weight models
#   (e.g. openai/gpt-oss-120b). Much higher rate limits — use for the eval harness
#   and fast local dev iteration. Grounding is enforced by us (verbatim-quote
#   substring verification), not by the provider.
LLM_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Hugging Face Inference Providers (https://huggingface.co/settings/tokens) ---
HF_API_KEY=hf_...
HF_MODEL=openai/gpt-oss-120b
HF_BASE_URL=https://router.huggingface.co/v1

# --- Misc ---
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
ANTHROPIC_TIMEOUT_SECONDS=60
ANTHROPIC_MAX_RETRIES=3
